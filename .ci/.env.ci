AUTHELIA_IMAGE=authelia/authelia:4.38.19

AUTHELIA_SESSION_SECRET=ci-fake-authelia-session-secret-0123456789abcdef
AUTHELIA_STORAGE_ENCRYPTION_KEY=ci-fake-authelia-storage-key-0123456789abcdef

HOST=ci-node.invalid

PSIBASE_ADMIN_IP=172.30.0.10

PRODUCER_NAME=ci-producer

DB_CACHE_SIZE=2GiB

EMAIL=ci@example.invalid

CLOUDFLARE_API_TOKEN=ci-fake-cloudflare-api-token-not-real

SOFTHSM_PIN=ci-fake-softhsm-pin-0123456789
