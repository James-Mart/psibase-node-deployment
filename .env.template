# psinode image. The x-admin peers panel needs a build that includes
# gofractally/psibase#1987 (merged 2026-08-10). No release contains it yet;
# the newest, v0.25.0-pre (2026-08-05), predates that merge. Track
# https://github.com/gofractally/psibase/releases after that date. An image
# bump does not upgrade node-local packages on an existing database — see
# SETUP.md "Updating psinode".
PSINODE_IMAGE=#ghcr.io/gofractally/psinode:<tag>

# Authelia image for session auth and password hashing during setup
AUTHELIA_IMAGE=authelia/authelia:4.38.19

# Authelia secrets — generate with:
# docker run --rm ${AUTHELIA_IMAGE} authelia crypto rand --length 64 --charset alphanumeric
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# Domain name used as the host in the nginx config and also as the "--host" argument to psinode
HOST=#psibase.io

PSIBASE_ADMIN_IP=172.30.0.10 # Psinode container static ip (from docker compose config)

# Used as the value of the "--producer" argument to psinode.
PRODUCER_NAME=#myprod

# Used as the value of the "--database-cache-size" argument to psinode.
DB_CACHE_SIZE=2GiB

# The email address used with your dns resolver (e.g. cloudflare).
EMAIL=#your-email@example.com

# This cloudflare API token needs to have the following permissions:
# - Zone - DNS - Edit
# - Zone - Zone - Read
CLOUDFLARE_API_TOKEN=#e.g. Xk9mPa-Vy4jdN82M3h8zf5w1qJLnxpyRst7m1hvK

# SoftHSM2 PIN configuration. Do NOT use characters: '$' or '#'
SOFTHSM_PIN=#Create a secure PIN for SoftHSM2
